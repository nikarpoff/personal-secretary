# Backend и OpenClaw читают один .env через Compose env_file.

# ---- Personal Assistant -------------------------------------------------------

# Ключ REST API и MCP-эндпоинта; OpenClaw передаёт его в заголовке. Сгенерируйте: openssl rand -hex 32
AUTH_TOKEN=<change_me>
# Часовой пояс владельца: время без смещения считается в нём
TIMEZONE=Europe/Moscow

# Google Calendar: токен, который выдал scripts/authorize_google.py (не JSON OAuth-клиента!),
# или ключ сервисного аккаунта
GOOGLE_CREDENTIALS_FILE=/secrets/google.json
# primary - основной календарь аккаунта; для сервисного аккаунта - e-mail владельца календаря
GOOGLE_CALENDAR_ID=primary
# Интервал чтения Google Calendar в секундах и горизонт событий в днях.
CALENDAR_SYNC_INTERVAL=60
CALENDAR_SYNC_DAYS=30
# Цвет события, который означает «важное»: 11 - «Томатный» (красный)
IMPORTANT_COLOR_ID=11

# Тот же бот, что обслуживает OpenClaw (токен от @BotFather), и ваш числовой Telegram user id
TELEGRAM_BOT_TOKEN=<from_botfather>
TELEGRAM_CHAT_ID=<your_user_id>
# За сколько минут напоминать о событии, у которого уведомления по умолчанию
REMINDER_MINUTES=15
# Дополнительные напоминания о важных событиях: за сутки и за два часа
IMPORTANT_REMINDER_MINUTES=1440,120

# ---- Obsidian ---------------------------------------------------------------
# Host paths are fixed in Compose: ./data/obsidian/Secretary and ./data/assistant-state.
NOTES_ROOT=/notes
ASSISTANT_STATE_DIR=/assistant-state
# Same local vault name on Windows/Android, or set this remote base directory in Remotely Save.
OBSIDIAN_VAULT_NAME=Obsidian
# Для локального запуска замените оба контейнерных пути выше абсолютными путями на машине.
NOTE_REMINDER_POLL_SECONDS=30
# Optional profile obsidian-sync: DNS A/AAAA must point to the VPS; ports 80/443 must be free.
# Создайте secrets/webdav.env с отдельными WEBDAV_USERNAME и WEBDAV_PASSWORD.
# Например: WEBDAV_USERNAME=secretary-sync, WEBDAV_PASSWORD=<длинный-случайный-пароль>.
# Эти две переменные не добавляйте в общий .env; WebDAV читает отдельный env_file.
OBSIDIAN_SYNC_DOMAIN=notes.example.com

# Настройки логирования
LOG_LEVEL=INFO
LOG_DIAGNOSE=False

# ---- OpenClaw -----------------------------------------------------------------

# LLM агента через OpenRouter: ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=<sk-or-...>
# Модель в формате openrouter/<автор>/<модель>; нужна модель с вызовом инструментов (tool calling).
# Список: scripts/openclaw.sh models list --provider openrouter --all
OPENCLAW_MODEL=openrouter/anthropic/claude-haiku-5.5
# Токен шлюза для Control UI и CLI. Сгенерируйте: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=<change_me>
# Образ OpenClaw; когда всё заработает, зафиксируйте версию вместо latest
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# Часовой пояс контейнера OpenClaw (время в логах и в автоматизациях)
TZ=Europe/Moscow

# Входящие голосовые: Whisper распознаёт аудио, OpenClaw передаёт текст ассистенту.
# Полный URL endpoint, включая /v1/audio/transcriptions.
WHISPER_URL=https://whisper.example.com/v1/audio/transcriptions
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru
# Заполните, если Whisper требует Bearer-авторизацию.
WHISPER_API_KEY=

# Числа для web tools: wrapper преобразует их в числа при config patch --stdin.
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=20
WEB_SEARCH_CACHE_TTL_MINUTES=15
WEB_FETCH_MAX_CHARS=6000
WEB_FETCH_MAX_CHARS_CAP=8000
WEB_FETCH_MAX_RESPONSE_BYTES=250000
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_FETCH_CACHE_TTL_MINUTES=15
WEB_FETCH_MAX_REDIRECTS=3

# Если OpenRouter, Google или Telegram недоступны с сервера напрямую - прокси для исходящих запросов обоих контейнеров
# HTTPS_PROXY=http://host.docker.internal:10809
NO_PROXY=personal-assistant,localhost,127.0.0.1
