# Один .env на сервис и шлюз OpenClaw. Сгенерировать токен: openssl rand -hex 32

# ---- Personal Assistant -------------------------------------------------------

# Ключ REST API и MCP-эндпоинта сервиса; его же OpenClaw передаёт в заголовке
AUTH_TOKEN=<change_me>
# Часовой пояс владельца: время без смещения считается в нём
TIMEZONE=Europe/Moscow

# Токен из scripts/authorize_google.py или ключ сервисного аккаунта
GOOGLE_CREDENTIALS_FILE=/secrets/google.json
# primary - основной календарь; для сервисного аккаунта - e-mail владельца календаря
GOOGLE_CALENDAR_ID=primary
# Как часто (секунды) и на сколько дней вперёд читать календарь
CALENDAR_SYNC_INTERVAL=60
CALENDAR_SYNC_DAYS=30
# Цвет важного события: 11 - красный
IMPORTANT_COLOR_ID=11

# Бот от @BotFather (тот же, что у OpenClaw) и ваш числовой Telegram user id
TELEGRAM_BOT_TOKEN=<change_me>
TELEGRAM_CHAT_ID=<change_me>
# Напоминания за N минут; у важных событий - ещё за сутки и за два часа
REMINDER_MINUTES=15
IMPORTANT_REMINDER_MINUTES=1440,120

LOG_LEVEL=INFO
LOG_DIAGNOSE=False

# ---- OpenClaw -----------------------------------------------------------------

# LLM агента через OpenRouter; модель должна уметь вызывать инструменты
OPENROUTER_API_KEY=<change_me>
OPENCLAW_MODEL=openrouter/anthropic/claude-haiku-5.5
# Токен Control UI и CLI шлюза
OPENCLAW_GATEWAY_TOKEN=<change_me>
# Часовой пояс контейнеров: время в логах и автоматизациях
TZ=Europe/Moscow

# Голосовые: Whisper с OpenAI-совместимым API (POST <WHISPER_BASE_URL>/audio/transcriptions)
WHISPER_BASE_URL=https://whisper.example.com/v1
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=ru
# Bearer-ключ Whisper; без авторизации - любое непустое значение
WHISPER_API_KEY=<change_me>

# Прокси для исходящих запросов, если OpenRouter, Google или Telegram недоступны напрямую
# HTTPS_PROXY=http://host.docker.internal:10809
NO_PROXY=personal-assistant,basic-memory,localhost,127.0.0.1
