// Патч конфига OpenClaw для ИИ-секретаря. Применение (поверх конфига после onboard):
//   scripts/openclaw.sh config patch --stdin < openclaw/openclaw.patch.json5
// Перед этим замените <YOUR_TELEGRAM_USER_ID> на свой числовой id (тот же, что TELEGRAM_CHAT_ID).
// ${VAR} OpenClaw подставляет из окружения шлюза, то есть из .env.
{
  agents: {
    defaults: {
      // Время в системном промпте агента: тот же пояс, что TIMEZONE сервиса
      userTimezone: "Europe/Moscow",
    },
  },
  channels: {
    telegram: {
      enabled: true,
      // Токен бота OpenClaw берёт из TELEGRAM_BOT_TOKEN. Отвечает только владельцу
      dmPolicy: "allowlist",
      allowFrom: ["<YOUR_TELEGRAM_USER_ID>"],
    },
  },
  commands: {
    // Владелец слэш-команд OpenClaw (/model, /status) - вы
    ownerAllowFrom: ["telegram:<YOUR_TELEGRAM_USER_ID>"],
  },
  tools: {
    // Секретарю не нужны shell, запись файлов и веб: чужое приглашение в календарь может нести
    // prompt injection. messaging пропускает MCP-инструменты, read нужен для чтения SKILL.md
    profile: "messaging",
    alsoAllow: ["read"],
    // read may read only the agent workspace, including workspace/skills/secretary/SKILL.md.
    // The vault is outside this workspace and is not mounted into the gateway at all.
    fs: { workspaceOnly: true },
    elevated: { enabled: false },
    deny: ["group:runtime", "write", "edit", "apply_patch", "sessions_spawn", "sessions_send"],
    media: {
      // Голосовые сначала распознаёт внешний Whisper; stdout обработчика получает ассистент.
      models: [
        {
          type: "cli",
          command: "node",
          args: ["--use-env-proxy", "/opt/secretary/transcribe-whisper.mjs", "{{AttachmentPath}}"],
          capabilities: ["audio"],
          timeoutSeconds: 150,
        },
      ],
      audio: {
        enabled: true,
        maxBytes: 20971520,
      },
    },
  },
  skills: {
    entries: {
      // Встроенный навык Google Workspace тоже умеет календарь: выключен, чтобы агент не путал источники
      gog: { enabled: false },
    },
  },
  mcp: {
    servers: {
      // Calendar + bounded note tools; key is the backend AUTH_TOKEN.
      "personal-assistant": {
        url: "http://personal-assistant:8000/mcp/",
        transport: "streamable-http",
        requestTimeoutMs: 30000,
        headers: {
          Authorization: "Bearer ${AUTH_TOKEN}",
        },
      },
    },
  },
}
