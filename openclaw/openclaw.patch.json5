// Патч конфига OpenClaw для ИИ-секретаря. Он дополняет конфиг, который создал onboard.
// Секретов и личных данных здесь нет: ${VAR} OpenClaw подставляет из окружения шлюза (.env)
// при каждой загрузке конфига. Числовые WEB_* преобразует scripts/openclaw.sh перед patch.
//   scripts/openclaw.sh config patch --stdin < openclaw/openclaw.patch.json5
{
  agents: {
    defaults: {
      // LLM агента: OPENCLAW_MODEL, ключ OPENROUTER_API_KEY берётся из .env по ссылке, которую записал onboard
      model: { primary: "${OPENCLAW_MODEL}" },
      // Время в системном промпте агента: тот же пояс, что у сервиса
      userTimezone: "${TIMEZONE}",
    },
  },
  models: {
    providers: {
      openrouter: {
        params: {
          provider: {
            // Только провайдеры модели, которые поддерживают все параметры запроса, в том числе tools
            require_parameters: true,
            // Календарь не уходит провайдерам, которые сохраняют запросы для обучения
            data_collection: "deny",
          },
        },
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      // Токен бота OpenClaw берёт из TELEGRAM_BOT_TOKEN. Отвечает только владельцу
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_CHAT_ID}"],
    },
  },
  commands: {
    // Владелец слэш-команд OpenClaw (/model, /status)
    ownerAllowFrom: ["telegram:${TELEGRAM_CHAT_ID}"],
  },
  tools: {
    // MCP для календаря/заметок, read для навыка; веб доступен только через поиск и чтение страниц.
    // Текст сайтов и заметок считается данными: команды и запись файлов модели не разрешены.
    profile: "messaging",
    alsoAllow: ["read", "web_search", "web_fetch"],
    // secretary is mounted read-only into workspace/skills/secretary from the repository.
    // read may read only the agent workspace, including that mounted skill.
    // The vault is outside this workspace and is not mounted into the gateway at all.
    fs: { workspaceOnly: true },
    elevated: { enabled: false },
    deny: ["group:runtime", "write", "edit", "apply_patch", "sessions_spawn", "sessions_send"],
    web: {
      search: {
        enabled: true,
        // Install and enable @openclaw/duckduckgo-plugin before applying this patch.
        // Explicit selection keeps search on DuckDuckGo for the selected model.
        provider: "duckduckgo",
        maxResults: "${WEB_SEARCH_MAX_RESULTS}", // default count, not a per-turn budget
        timeoutSeconds: "${WEB_SEARCH_TIMEOUT_SECONDS}",
        cacheTtlMinutes: "${WEB_SEARCH_CACHE_TTL_MINUTES}",
      },
      fetch: {
        enabled: true,
        readability: true,
        maxChars: "${WEB_FETCH_MAX_CHARS}",
        maxCharsCap: "${WEB_FETCH_MAX_CHARS_CAP}",
        maxResponseBytes: "${WEB_FETCH_MAX_RESPONSE_BYTES}",
        timeoutSeconds: "${WEB_FETCH_TIMEOUT_SECONDS}",
        cacheTtlMinutes: "${WEB_FETCH_CACHE_TTL_MINUTES}",
        maxRedirects: "${WEB_FETCH_MAX_REDIRECTS}",
        ssrfPolicy: { dangerouslyAllowPrivateNetwork: false },
      },
    },
    media: {
      // Голосовые сначала распознаёт внешний Whisper; stdout обработчика получает ассистент.
      models: [
        {
          type: "cli",
          command: "node",
          args: ["--use-env-proxy", "/opt/secretary/transcribe-whisper.mjs", "{{AttachmentPath}}"],
          capabilities: ["audio"],
          timeoutSeconds: 150,
        },
      ],
      audio: {
        enabled: true,
        maxBytes: 20971520,
      },
    },
  },
  plugins: {
    entries: {
      duckduckgo: {
        enabled: true,
        config: { webSearch: { safeSearch: "moderate" } },
      },
    },
  },
  skills: {
    // secretary is discovered in workspace/skills; no paths outside the workspace are needed.
    entries: {
      // Встроенный навык Google Workspace тоже умеет календарь: выключен, чтобы агент не путал источники
      gog: { enabled: false },
    },
  },
  mcp: {
    servers: {
      // Calendar + bounded note tools; key is the backend AUTH_TOKEN.
      "personal-assistant": {
        url: "http://personal-assistant:8000/mcp/",
        transport: "streamable-http",
        requestTimeoutMs: 30000,
        headers: {
          Authorization: "Bearer ${AUTH_TOKEN}",
        },
      },
    },
  },
}
