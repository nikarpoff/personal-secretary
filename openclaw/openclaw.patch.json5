// Патч конфига OpenClaw для ИИ-секретаря. Он дополняет конфиг, который создал onboard.
// Секретов и личных данных здесь нет: ${VAR} OpenClaw подставляет из окружения шлюза (.env)
// при каждой загрузке конфига, поэтому файл лежит в git как есть.
//   scripts/openclaw.sh config patch --stdin < openclaw/openclaw.patch.json5
{
  agents: {
    defaults: {
      // LLM агента: OPENCLAW_MODEL, ключ OPENROUTER_API_KEY берётся из .env по ссылке, которую записал onboard
      model: { primary: "${OPENCLAW_MODEL}" },
      // Время в системном промпте агента: тот же пояс, что у сервиса
      userTimezone: "${TIMEZONE}",
      // Heartbeat выключен: без HEARTBEAT.md он каждые 30 минут гонял весь контекст сессии впустую,
      // а напоминания о событиях присылает сам сервис
      heartbeat: { every: "0m" },
    },
  },
  models: {
    providers: {
      // Провайдер openai здесь - только протокол Whisper: ключ его сервиса, не OpenAI
      openai: {
        apiKey: "${WHISPER_API_KEY}",
      },
      openrouter: {
        params: {
          provider: {
            // Только провайдеры модели, которые поддерживают все параметры запроса, в том числе tools
            require_parameters: true,
            // Календарь не уходит провайдерам, которые сохраняют запросы для обучения
            data_collection: "deny",
          },
        },
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      // Токен бота OpenClaw берёт из TELEGRAM_BOT_TOKEN. Отвечает только владельцу
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_CHAT_ID}"],
    },
  },
  commands: {
    // Владелец слэш-команд OpenClaw (/model, /status)
    ownerAllowFrom: ["telegram:${TELEGRAM_CHAT_ID}"],
  },
  tools: {
    // Секретарю не нужны shell и запись файлов: приглашение в календарь или веб-страница могут нести
    // prompt injection. messaging пропускает MCP-инструменты, read читает навык, веб - только поиск и чтение
    profile: "messaging",
    alsoAllow: ["read", "web_search", "web_fetch"],
    // read видит только рабочий каталог агента; навык смонтирован в него из репозитория
    fs: { workspaceOnly: true },
    elevated: { enabled: false },
    deny: ["group:runtime", "write", "edit", "apply_patch", "sessions_spawn", "sessions_send"],
    web: {
      // Числа здесь, а не в .env: ${VAR} OpenClaw подставляет строкой, а эти поля - числовые
      search: {
        enabled: true,
        // DuckDuckGo - плагин @openclaw/duckduckgo-plugin, ставится перед применением патча
        provider: "duckduckgo",
        maxResults: 5,
        timeoutSeconds: 20,
        cacheTtlMinutes: 15,
      },
      fetch: {
        enabled: true,
        readability: true,
        maxChars: 6000,
        maxCharsCap: 8000,
        maxResponseBytes: 250000,
        timeoutSeconds: 20,
        cacheTtlMinutes: 15,
        maxRedirects: 3,
      },
    },
    media: {
      // Голосовые распознаёт ваш Whisper с OpenAI-совместимым API, ассистент получает текст
      models: [
        {
          provider: "openai",
          model: "${WHISPER_MODEL}",
          baseUrl: "${WHISPER_BASE_URL}",
          language: "${WHISPER_LANGUAGE}",
          capabilities: ["audio"],
          timeoutSeconds: 150,
        },
      ],
      audio: {
        enabled: true,
        maxBytes: 20971520,
      },
    },
  },
  plugins: {
    deny: ["cua-computer", "linux-node", "device-pair", "github", "geolocation", "talk-voice", "anthropic", "xai", "ollama"],
    entries: {
      duckduckgo: {
        enabled: true,
        config: { webSearch: { safeSearch: "moderate" } },
      },
    },
  },
  skills: {
    entries: {
      // Встроенный навык Google Workspace тоже умеет календарь: выключен, чтобы агент не путал источники
      gog: { enabled: false },
    },
  },
  mcp: {
    servers: {
      // Календарь; ключ тот же, что AUTH_TOKEN сервиса
      "personal-assistant": {
        url: "http://personal-assistant:8000/mcp/",
        transport: "streamable-http",
        requestTimeoutMs: 30000,
        headers: {
          Authorization: "Bearer ${AUTH_TOKEN}",
        },
      },
      // Заметки: хранилище Obsidian через Basic Memory. Удалять заметки и управлять проектами агенту
      // незачем: в списке только чтение, поиск, запись, правка и перенос в архив
      notes: {
        url: "http://basic-memory:8000/mcp",
        transport: "streamable-http",
        requestTimeoutMs: 30000,
        toolFilter: {
          include: ["bm_write", "bm_edit", "bm_read", "bm_search", "bm_find", "bm_list", "bm_context", "bm_move"],
        },
      },
    },
  },
}
